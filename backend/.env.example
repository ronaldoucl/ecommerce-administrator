PORT=4000
# PostgreSQL connection string (cloud providers need ?sslmode=require)
DATABASE_URL=
JWT_SECRET=
# Admin account created by `npx prisma db seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Stock level that flags a variant as low stock (default 5)
LOW_STOCK_THRESHOLD=5
# Allowed frontend origins for CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173
# Brevo API, for order status emails. Optional: leave empty to disable them.
# MAIL_FROM_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
# Cloudinary, for product image uploads. Optional: leave empty and only image
# URLs can be used. CLOUDINARY_FOLDER defaults to "ecommerce-administrator/products".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
