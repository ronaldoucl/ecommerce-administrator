PORT=4000
# Cloud PostgreSQL connection string. Cloud providers require SSL — append ?sslmode=require.
# Supabase: prefer the connection pooler URI. Render: use the External Database URL.
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
JWT_SECRET=
# Admin seed credentials (used by `npx prisma db seed`). Set real values in .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Low-stock threshold: a variant is flagged low stock when its stock is at or
# below this value (and still above 0). Integer, defaults to 5 when unset or invalid.
LOW_STOCK_THRESHOLD=5
# Allowed frontend origin(s) for CORS, comma-separated. Local Vite dev server by
# default. Any *.vercel.app deployment is always allowed (covers Vercel previews).
# Production example:
#   CLIENT_ORIGIN=http://localhost:5173,https://ecommerce-administrator.vercel.app
CLIENT_ORIGIN=http://localhost:5173
# Customer notification emails sent on an order status change
# (see src/services/emailService.js). There are two transports; configure ONE.
# OPTIONAL: leave both empty and the notification switch in the admin dashboard
# stays unavailable — order status changes still work, the customer is simply not
# emailed and the API reports "emailSent": false.
# The on/off switch itself is NOT an environment variable: it lives in the store
# settings (StoreSettings.emailEnabled) and is toggled from Dashboard > Settings.
# Delivery goes through Brevo's HTTP API — plain HTTPS, sent with fetch, so it
# needs no npm package. HTTP and not SMTP on purpose: Render's FREE plan blocks
# outbound traffic to the SMTP ports (25/465/587), so direct SMTP cannot work
# there, while HTTPS is unaffected.
# Setup:
#   1. Create a free Brevo account (300 emails/day).
#   2. SMTP & API > API Keys > generate a key -> BREVO_API_KEY.
#   3. Senders, Domains & Dedicated IPs > Senders > add the From address and
#      confirm it from the email Brevo sends -> MAIL_FROM_EMAIL.
# MAIL_FROM_EMAIL MUST be a verified sender: Brevo accepts the request and then
# silently discards the message otherwise, so the server refuses to send until
# it is verified and says so.
# MAIL_FROM_NAME is the display name the customer sees; defaults to "Store".
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
# Cloudinary hosts the product images uploaded from the admin panel
# (POST /api/uploads/image). OPTIONAL: leave these empty and the upload button
# reports that uploads are not configured, while pasting image URLs keeps working.
# The three values come from the Cloudinary dashboard ("Product Environment
# Credentials"). CLOUDINARY_FOLDER is optional and defaults to
# "ecommerce-administrator/products".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
